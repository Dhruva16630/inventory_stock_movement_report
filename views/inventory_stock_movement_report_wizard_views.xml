<odoo>

    <record id="view_inventory_stock_movement_report_wizard_form" model="ir.ui.view">

        <field name="name">inventory_stock.movement.report.wizard.form</field>
        <field name="model">inventory.stock.movement.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Stock Movement Report">
                <group>
                    <field name="from_date"/>
                    <field name="to_date"/>
                </group>

                <footer>
                    <button
                        name="action_generate_report"
                        string="Generate Report"
                        type="object"
                        class="btn-primary"
                    />

                    <button
                        string="Cancel"
                        special="cancel"
                        class="btn-secondary"
                    />

                </footer>

            </form>

        </field>
    </record>

    <record id="action_stock_movement_report_wizard" model="ir.actions.act_window">
        <field name="name">Stock Movement Report</field>
        <field name="res_model">inventory.stock.movement.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem
        id="menu_stock_movement_report_wizard"
        name="Stock Movement Report Wizard"
        parent="stock.menu_stock_root"
        action="action_stock_movement_report_wizard"
        sequence="50"
    />
</odoo>